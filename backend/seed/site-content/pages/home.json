  "presidentMessage": {
    "photo": "/images/ee7f66c5ea3c9afdea61f2a1c31204e3144803f494907afb2bb4b97a1ff61931.png",
    "name": {
      "ar": "بروفسيور أحمد عبد القادر آدم",
      "en": ""
    },
    "position": {
      "ar": "مدير الجامعة التكنولوجية",
