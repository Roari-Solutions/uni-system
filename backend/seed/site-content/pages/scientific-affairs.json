  "overview": {
    "title": {
      "ar": "نبذة عن الأمانة",
      "en": ""
    },
    "text": {
      "ar": "أمانة الشؤون العلمية هي إحدى الإدارات الرئيسية في الجامعة التي تعنى بتنظيم وتطوير الشؤون الأكاديمية والبحثية. نسعى دائمًا إلى تطوير خطط وبرامج الكليات لمواكبة التطورات العالمية في مختلف التخصصات العلمية.",
      "en": ""
    },
    "quote": {
      "content": {
        "ar": "نسعى لتقديم أفضل الخدمات الأكاديمية والبحثية للارتقاء بالعملية التعليمية في الجامعة.",
        "en": ""
      },
      "author": {
        "ar": "د. ناجي عبيد نعيم",
        "en": ""
      },
      "position": {
        "ar": "أمين الشؤون العلمية",
        "en": ""
      }
    }
  },
  "vision": {
    "title": {
      "ar": "الرؤية والرسالة والأهداف",
      "en": ""
    },
    "cards": [
      {
        "title": {
          "ar": "الرؤية",
          "en": ""
        },
        "icon": "activity",
        "items": [
          {
            "ar": "تتطلع الأمانة بأن تكون الجامعة مؤسسة أكاديمية معرفية بحثية تقنية رائدة ومتميزة في التعليم العالي محلياً وإقليمياً وعالمياً، تنشط في خدمة المجتمع وفقاً لمعايير الجودة وضمانها وتأكيدها.",
            "en": ""
          }
        ]
      },
      {
        "title": {
          "ar": "الرسالة",
          "en": ""
        },
        "icon": "monitor-play",
        "items": [
          {
            "ar": "تسعى أمانة الشؤون العلمية بالجامعة إلى تقديم تعليم متميز عبر برامج أكاديمية وبحثية وتقنية متطورة ومبتكرة تواكب متغيرات العصر وقضايا المجتمع وتلبي حاجاته.",
            "en": ""
          }
        ]
      },
      {
        "title": {
          "ar": "الأهداف",
          "en": ""
        },
        "icon": "users",
        "items": [
          {
            "ar": "تأهيل أطر تدريسية وفكرية مدربة قادرة على قيادة وتطوير العملية التعليمية.",
            "en": ""
          },
          {
            "ar": "تحقيق التميز في البرامج الأكاديمية والارتقاء بها وفق معايير وزارة التعليم العالي والبحث العلمي والمعايير الدولية.",
            "en": ""
          },
          {
            "ar": "تحفيز الطلاب على استخدام مكتسباتهم الأكاديمية ومهاراتهم المعرفية في حياتهم المهنية.",
            "en": ""
          },
          {
            "ar": "رفع مستوى الأداء الأكاديمي وتطوير تقييمه لضمان كفاءات علمية مؤهلة.",
            "en": ""
          },
          {
            "ar": "إعداد قادة مزودين بالمعرفة والمهارات ليكونوا منتجين في المجتمع.",
            "en": ""
          },
          {
            "ar": "توفير فرص التعليم المستمر للعاملين بسوق العمل ورفع مستوى الأداء والإنتاجية.",
            "en": ""
          },
          {
            "ar": "توثيق العلوم والبحوث وضمان الجودة والتميز العلمي.",
            "en": ""
          },
          {
            "ar": "ربط الجامعة بالمؤسسات العلمية والثقافية والمهنية محلياً وإقليمياً ودولياً وفتح آفاق توظيف الخريجين.",
            "en": ""
          }
        ]
      },
      {
        "title": {
          "ar": "القيم",
          "en": ""
        },
        "icon": "scale",
        "items": [
          {
            "ar": "تعزيز روح المواطنة وملاءمتها مع الأطر المنهجية.",
            "en": ""
          },
          {
            "ar": "الأمانة والمصداقية والشفافية.",
            "en": ""
          },
          {
            "ar": "المسؤولية واحترام الحريات والاعتراف بالتنوع.",
            "en": ""
          },
          {
            "ar": "الالتزام بالأخلاق الحميدة والسلوك القويم.",
            "en": ""
          },
          {
            "ar": "العمل وفق معايير الجودة الشاملة.",
            "en": ""
          },
          {
            "ar": "اتباع وسائل المحافظة على البيئة وتعزيز التوعية بها.",
            "en": ""
          }
        ]
      }
    ]
