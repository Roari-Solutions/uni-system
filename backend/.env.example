# Server
PORT=4000
NODE_ENV=production

# Database (Docker: use service name 'database')
DATABASE_URL=postgresql://admin:123@database:5432/uni

# Access tokens are signed with an ES256 key pair. Generate one with
#   sh scripts/jwt-keys.sh <kid>
# The private key stays here; the kid and public key also go to the LMS.
JWT_ACCESS_KID=your_key_id
JWT_ACCESS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
JWT_ACCESS_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n
# During a key rotation only: the previous key, until its tokens expire.
# JWT_ACCESS_PREVIOUS_KID=
# JWT_ACCESS_PREVIOUS_PUBLIC_KEY=

# Refresh tokens are read only here (generate with: openssl rand -hex 32)
JWT_REFRESH_SECRET=your_refresh_secret_here_32_chars_min

# JWT Expiration
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Secure flag on auth cookies (default true when NODE_ENV=production).
# Set false for plain-http deploys, otherwise browsers and curl drop them.
COOKIE_SECURE=true

# Where uploaded and seeded media is stored and served from (/images, /pdfs).
MEDIA_DIR=/data/

# Origins allowed to call the API, comma-separated: every sign-in portal and the
# public website. Leave unset in development to allow localhost and *.localhost.
# CORS_ORIGINS=https://www.example.edu,https://staff.example.edu,https://grades.example.edu,https://cms.example.edu

# The LMS keeps a read-only copy of the tables it needs through Postgres logical
# replication (the database must run with wal_level=logical; compose.yaml sets
# it). Setting this password creates the lms_replicator role and the lms_core
# publication on startup; the LMS subscribes with the same password.
# LMS_REPLICATION_PASSWORD=
