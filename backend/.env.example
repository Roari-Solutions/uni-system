# Server
PORT=4000
NODE_ENV=production

# Database (Docker: use service name 'database')
DATABASE_URL=postgresql://admin:123@database:5432/uni

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=your_access_secret_here_32_chars_min
JWT_REFRESH_SECRET=your_refresh_secret_here_32_chars_min

# JWT Expiration
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Secure flag on auth cookies (default true when NODE_ENV=production).
# Set false for plain-http deploys, otherwise browsers and curl drop them.
COOKIE_SECURE=true

# Where uploaded and seeded media is stored and served from (/images, /pdfs).
MEDIA_DIR=/data/

# Origins allowed to call the API, comma-separated: every sign-in portal and the
# public website. Leave unset in development to allow localhost and *.localhost.
# CORS_ORIGINS=https://www.example.edu,https://staff.example.edu,https://grades.example.edu,https://cms.example.edu
