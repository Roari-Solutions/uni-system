# Where the API lives. Leave unset to call /api/v1 on the same host (the dev
# server proxies it). With portals on separate subdomains, point every portal
# at one shared API host so a sign-in on one portal is a session on the others:
# VITE_API_URL=https://api.example.edu/api/v1

# The host each sign-in portal is served on. A host not listed here (plain
# localhost, a bare IP) serves the staff sign-in and every dashboard on one host.
# In development, <portal>.localhost works without listing it.
# VITE_PORTAL_HOSTS=staff=staff.example.edu,grades=grades.example.edu,cms=cms.example.edu,management=management.example.edu,teachers=teachers.example.edu,students=students.example.edu,lms=lms.example.edu

# The public website, for the content editor's "view on website" links.
# VITE_WEBSITE_URL=https://www.example.edu

# Trying the portals on subdomains locally: browsers treat *.localhost hosts as
# separate sites, so a session won't carry between them. Use lvh.me instead,
# which resolves every subdomain to 127.0.0.1:
#   VITE_API_URL=http://api.lvh.me:4000/api/v1
#   VITE_PORTAL_HOSTS=staff=staff.lvh.me,grades=grades.lvh.me,cms=cms.lvh.me
# and run the dev server with __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.lvh.me
